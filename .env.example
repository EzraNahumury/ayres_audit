# Copy to .env.local for local dev, or set as env vars in Hostinger hPanel for production.

# MySQL — use a dedicated user, not root.
DB_HOST=localhost
DB_PORT=3306
DB_USER=ayres_app
DB_PASS=__STRONG_PASSWORD_HERE__
DB_NAME=ayres_audit

# Auth token signing key (HMAC-SHA256). Min 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=__GENERATE_RANDOM_48_BYTES_BASE64URL__

# Ollama AI
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_API_KEY=__ROTATE_AND_PASTE_NEW_KEY__
